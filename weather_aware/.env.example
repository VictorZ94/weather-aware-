# Copy to .env and fill in. .env is never shared.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API from a browser (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HERE Geocoding & Search. Create a free key at https://platform.here.com
# (Access Manager -> your app -> API keys).
HERE_API_KEY=

# Forecasts come from the US National Weather Service (no key needed).
# It asks each application to identify itself with a contact (email or site).
NWS_USER_AGENT=weather-aware (you@example.com)

# Shows the "Simulate weather" selector, which plans with made-up weather.
# Leave unset to follow DEBUG; set to True to allow it where DEBUG is off.
# ALLOW_WEATHER_SIMULATION=True
